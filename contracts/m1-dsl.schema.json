{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "enum": [
            1920,
            1080
          ]
        },
        "height": {
          "enum": [
            1080,
            1920
          ]
        },
        "fps_num": {
          "const": 30
        },
        "fps_den": {
          "const": 1
        },
        "video_codec": {
          "const": "h264"
        }
      },
      "required": [
        "width",
        "height",
        "fps_num",
        "fps_den",
        "video_codec"
      ],
      "oneOf": [
        {
          "properties": {
            "width": {
              "const": 1920
            },
            "height": {
              "const": 1080
            }
          }
        },
        {
          "properties": {
            "width": {
              "const": 1080
            },
            "height": {
              "const": 1920
            }
          }
        }
      ]
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "track_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "type": {
            "const": "video"
          },
          "clips": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "clip_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "asset_id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                },
                "asset_version": {
                  "const": 1
                },
                "source_in_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "source_out_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "timeline_start_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "crop_mode": {
                  "enum": [
                    "center",
                    "fit"
                  ]
                }
              },
              "required": [
                "clip_id",
                "asset_id",
                "asset_version",
                "source_in_ms",
                "source_out_ms",
                "timeline_start_ms",
                "crop_mode"
              ]
            }
          }
        },
        "required": [
          "track_id",
          "type",
          "clips"
        ]
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "locked_clip_ids": {
          "type": "array",
          "maxItems": 0
        }
      },
      "required": []
    }
  },
  "required": [
    "schema_version",
    "output",
    "tracks"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticvideo.local/contracts/m1-dsl.schema.json"
}
